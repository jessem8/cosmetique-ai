# Copy to backend/.env for direct local development only. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql://cosmetique:URL_ENCODED_PASSWORD@localhost:5432/cosmetique_ai
SECRET_KEY=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
ARTIFACT_ROOT=./artifacts

# Authenticated Colab Quick Tunnel. Both values remain server-side.
AI_SERVICE_URL=https://replace-this.trycloudflare.com
AI_SERVICE_TOKEN=replace_with_a_long_random_bearer_token
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=30
AI_HEALTH_TIMEOUT_SECONDS=5

WORKER_ID=worker-1
WORKER_POLL_SECONDS=2
WORKER_REMOTE_POLL_SECONDS=2.5
WORKER_LEASE_SECONDS=90
WORKER_RETRY_DELAY_SECONDS=10
WORKER_JOB_DEADLINE_SECONDS=1800
