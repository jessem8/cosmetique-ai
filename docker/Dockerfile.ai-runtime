# CUDA-enabled private runtime for Campaign Studio V2.
#
# The image contains the product-extraction model stack only. Secrets and
# model snapshots are supplied at runtime through Compose and persistent volumes.
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_CACHE_ROOT=/models \
    ARTIFACT_ROOT=/artifacts \
    PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Keep torch from the CUDA base image. The lock contains the model/runtime
# libraries that are independent of the host GPU driver.
COPY ai/requirements-gpu-extraction.lock /tmp/ai-runtime-requirements.txt
RUN python -m pip install --break-system-packages \
        --requirement /tmp/ai-runtime-requirements.txt \
        hydra-core==1.3.2 \
        iopath==0.1.10 \
        omegaconf==2.3.0 \
        hatchling==1.27.0 \
    && rm -f /tmp/ai-runtime-requirements.txt

# Grounded-SAM-2 uses Meta's native static-image predictor rather than a
# Transformers video-checkpoint conversion. The optional CUDA extension is not
# required for image inference.
RUN git clone --depth 1 https://github.com/facebookresearch/sam2.git /tmp/sam2 \
    && SAM2_BUILD_CUDA=0 python -m pip install --break-system-packages --no-build-isolation --no-deps /tmp/sam2 \
    && rm -rf /tmp/sam2

COPY ai_core/ /tmp/ai_core/
RUN python -m pip install --break-system-packages --no-build-isolation --no-deps /tmp/ai_core/ \
    && rm -rf /tmp/ai_core

COPY ai_service/ /app/ai_service/
COPY ai/ /app/ai/

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /models /artifacts \
    && chown -R appuser:appuser /app /models /artifacts

USER appuser
EXPOSE 8000

# Import the ASGI module exactly once. The runtime contains no background
# generation pipeline and never loads SDXL.
ENTRYPOINT ["uvicorn", "ai.gpu_runtime:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
