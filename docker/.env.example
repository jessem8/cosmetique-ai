# Copy to docker/.env and replace every required value. Never commit docker/.env.
DB_USER=cosmetique
DB_NAME=cosmetique_ai
DB_PASSWORD=replace_with_a_long_url_safe_random_password
DATABASE_URL=postgresql://cosmetique:replace_with_a_long_url_safe_random_password@db:5432/cosmetique_ai
SECRET_KEY=replace_with_at_least_32_random_bytes

# Hugging Face is scoped to ai-runtime. Keep it out of backend/frontend envs.
HF_TOKEN=replace_with_huggingface_read_token
AI_SERVICE_URL=http://ai-runtime:8000
AI_SERVICE_TOKEN=replace_with_a_long_random_bearer_token

# Extraction-only runtime. Native SAM2 is selected when the GPU passes the
# capability probe; MX350/Pascal-class hardware uses CPU ONNX U2Net.
GPU_RUNTIME_MODE=auto
V2_PROVIDER_ALLOWLIST=product-extraction:native-sam2
V2_DEFAULT_PROVIDER=product-extraction
V2_DEFAULT_PROVIDER_PROFILE=native-sam2
V2_MAX_VARIANTS=1
V2_MAX_BUDGET_MICROS=0
V2_MAX_ATTEMPTS=1
V2_ESTIMATED_COST_PER_VARIANT_MICROS=0

# If APP_PORT changes (for example to 8080), include it in APP_ORIGIN.
APP_PORT=80
APP_ORIGIN=http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
WORKER_JOB_DEADLINE_SECONDS=1800
