# Copy to docker/.env and replace every required value before starting Compose.
# Never commit docker/.env.

DB_USER=cosmetique
DB_NAME=cosmetique_ai
DB_PASSWORD=replace_with_a_long_random_password
SECRET_KEY=replace_with_at_least_32_random_bytes

# Current authenticated Colab Quick Tunnel service.
AI_SERVICE_URL=https://replace-this.trycloudflare.com
AI_SERVICE_TOKEN=replace_with_a_long_random_bearer_token

# Local application settings.
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
ARTIFACT_ROOT=/app/artifacts

