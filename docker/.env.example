# Copy to docker/.env and replace every required value. Never commit docker/.env.
DB_USER=cosmetique
DB_NAME=cosmetique_ai
DB_PASSWORD=replace_with_a_long_url_safe_random_password
DATABASE_URL=postgresql://cosmetique:replace_with_a_long_url_safe_random_password@db:5432/cosmetique_ai
SECRET_KEY=replace_with_at_least_32_random_bytes

COLAB_AI_URL=https://replace-this.ngrok-free.app
AI_SERVICE_TOKEN=replace_with_a_long_random_bearer_token

# V2 is CloseRouter-backed. Keep the key server-side and never expose it to
# the browser or Colab notebook.
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
CLOSEROUTER_API_KEY=replace_with_closerouter_key
V2_PROVIDER_ALLOWLIST=closerouter:openai:openai/gpt-image-2
V2_DEFAULT_PROVIDER=closerouter
V2_DEFAULT_PROVIDER_PROFILE=openai
V2_MAX_VARIANTS=1
V2_MAX_BUDGET_MICROS=2000000
V2_MAX_ATTEMPTS=1
V2_ESTIMATED_COST_PER_VARIANT_MICROS=1000000

# If APP_PORT changes (for example to 8080), include it in APP_ORIGIN.
APP_PORT=80
APP_ORIGIN=http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
WORKER_JOB_DEADLINE_SECONDS=1800
